    "E014": {
      "characters": [
        "赵铁柱",
        "赵春花",
        "宋青禾"
      ],
      "first_recorded_chapter": 10,
      "id": "E014",
      "objective_fact": "赵家要把赵春花卖给黑石沟一个死了老婆的光棍，一百八十块，已收五十定钱，次日一早来领人；当夜春花翻梁逃到陆家，被宋青禾收下当女工",
      "reader_knowledge": "同客观事实（春花亲口说出）",
      "reveal_chapter": 11,
      "reveal_status": "已揭示",
      "story_time": "1983年春，换亲后约第三十九天",
      "updated_chapter": 11
    },
    "E015": {
      "characters": [
        "宋青禾",
        "赵春花",
        "赵铁柱",
        "陆长庚",
        "孙守田"
      ],
      "first_recorded_chapter": 12,
      "id": "E015",
      "objective_fact": "赵铁柱带人到陆家要人被挡；春花当众作证小年夜那晚；刘家峪刘老汉退回两百块告到公社；赵铁柱被民兵扭送公社公安特派员",
      "reader_knowledge": "同客观事实；谁把刘秀兰推下井春花没看见，由公社定",
      "reveal_chapter": 12,
      "reveal_status": "已揭示",
      "story_time": "1983年春，换亲后第四十天",
      "updated_chapter": 12
