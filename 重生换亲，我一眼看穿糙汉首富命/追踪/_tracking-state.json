    "continuity_risks": [
      "陆家欠账：赵家赖掉的迎亲车钱、孟家人情（她已帮工还）、卫生院欠条二十块上下（和断亲字据、结婚证揣一处，正文不报数）、跟县里战友借的三十块（第10章她还）、爹看病的老债",
      "老刘头（山后头、五十多、死了老婆）和赵春花设定里要卖给的「山那边老光棍」是两个人，别混",
      "断亲字据只三条，老刘头的事是支书口头加的，不在条文里",
      "小满糖盒里两颗橘子味水果糖；陆长庚上回借钱被人关在门外；他打猎的牛皮绳改成了缝纫机皮带；他那件棉袄肩头口子已被她用机器缝上"
    ],
    "long_term_constraints": [
      "天眼只让宋青禾看见气运颜色，怎么破局、拍板永远靠她自己；她看不见自己的命",
      "上一世的惨只用闪回点到，不展开写虐；女主每章都主动出手",
      "陆长庚金光是「首富之夫」命、黑线是她生意的劫映在他头上——尾声前不揭开；她目前以为是他的首富命和牢狱之灾",
      "前世真相（娘明知赵铁柱打死前妻仍收钱换亲，主意是姐姐出的）第3卷前只埋不点破"
    ],
    "next_chapter_commitments": [
      "从机器到家第二天早上接：裁缝摊开张，先给小满做花褂子兑现",
      "葛裁缝的撂话要正面顶上"
    ],
    "position": {
      "scene": "宋家沟村尾陆家外屋",
      "story_time": "1983年开春，换亲后约第十天清早",
      "volume": "第一卷·换亲当天，我挑了赶车的",
      "volume_start_chapter": 1
    },
    "recent_chapters": [
      {
        "chapter": 3,
        "summary": "进陆家头一天，她看见小满头顶灰里带黑闪得飞快，一按一松逼出孩子瞒疼三天；她押上脸面拍板当夜送乡卫生院，陆长庚借孟家驴车上十八里山路；半道小满说「嫂子，我不疼了」，黑气沉到眉骨，她喊快。"
      },
      {
        "chapter": 4,
        "summary": "赶到乡卫生院，大夫先当吃坏肚子，她让按下再松手，大夫变脸：阑尾化脓快穿孔，当夜开刀；陆长庚当外人认她「她嫂子。我媳妇」；钱不够打欠条，她添名按手印；小满得救，天亮揪她衣角问会不会做花褂子。"
      },
      {
        "chapter": 5,
        "summary": "小满住院三天，出院那天两人拿支书介绍信上公社领了结婚证，正是娘说她要回去跪的第三天；回村挨闲话，陆长庚一句「我妹子这条命，是她捡回来的」堵回去；葛裁缝当众堵她；她拍板要缝纫机，他进山借钱六天后深夜扛回旧机器，她连夜修好。"
      }
    ]
  },
