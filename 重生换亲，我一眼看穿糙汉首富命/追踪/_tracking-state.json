    "E005": {
      "characters": [
        "宋青禾",
        "陆长庚",
        "陆小满"
      ],
      "first_recorded_chapter": 3,
      "id": "E005",
      "objective_fact": "小满急性阑尾炎化脓瞒疼三天，宋青禾当夜拍板送乡卫生院，陆长庚借孟家驴车走十八里山路；半路小满说不疼了，实为快要穿孔",
      "reader_knowledge": "读者知道她靠天眼看出凶险，「不疼了」最吓人；病名还没说",
      "reveal_chapter": 3,
      "reveal_status": "部分揭示",
      "story_time": "1983年开春，换亲当天夜里",
      "updated_chapter": 3
    },
    "E006": {
      "characters": [
        "宋青禾",
        "陆长庚",
        "陆小满"
      ],
      "first_recorded_chapter": 4,
      "id": "E006",
      "objective_fact": "乡卫生院当夜给小满开刀切阑尾放脓，救回；陆家钱不够，打欠条一式两份，陆长庚、宋青禾署名按手印，秋后交清",
      "reader_knowledge": "同客观事实；大夫和陆长庚只当她「看人准」",
      "reveal_chapter": 4,
      "reveal_status": "已揭示",
      "story_time": "1983年开春，换亲次日凌晨到天亮",
      "updated_chapter": 4
    },
    "E007": {
      "characters": [
        "宋青禾",
        "陆长庚"
      ],
      "first_recorded_chapter": 5,
      "id": "E007",
      "objective_fact": "宋青禾、陆长庚凭大队介绍信在公社登记结婚，领红纸结婚证",
      "reader_knowledge": "同客观事实；娘那边还不知道",
      "reveal_chapter": 5,
      "reveal_status": "已揭示",
      "story_time": "1983年开春，换亲后第三天",
      "updated_chapter": 5
    },
    "E008": {
      "characters": [
        "宋青禾",
        "陆长庚"
      ],
      "first_recorded_chapter": 5,
      "id": "E008",
      "objective_fact": "陆长庚进山卖野物、跟县里战友借三十块，共六天，扛回一台锈死的旧缝纫机，宋青禾连夜修好",
      "reader_knowledge": "读者只知「野物卖了，跟县里战友借的」，不知数目",
      "reveal_chapter": 5,
      "reveal_status": "部分揭示",
      "story_time": "1983年开春，换亲后约第九天深夜到天亮",
      "updated_chapter": 5
    },
    "E009": {
      "characters": [
        "宋青禾",
        "陆长庚",
        "宋青梅",
        "周文斌",
        "葛秀珍",
        "孙巧云"
      ],
      "first_recorded_chapter": 6,
      "id": "E009",
      "objective_fact": "裁缝摊开张：孟婶第一单，小满花褂子，支书家把七尺红的确良（八块四）嫁衣交给她，婚期十天后；宋青梅的新衣被说破是旧衣翻新",
      "reader_knowledge": "同客观事实",
      "reveal_chapter": 6,
      "reveal_status": "已揭示",
      "story_time": "1983年开春，换亲后约第十到十一天",
      "updated_chapter": 6
    },
    "E010": {
      "characters": [
        "宋青禾",
        "陆长庚",
        "孙巧云",
        "葛秀珍",
        "孙守田"
      ],
      "first_recorded_chapter": 7,
      "id": "E010",
      "objective_fact": "孙巧云穿宋青禾做的嫁衣出嫁，婆家拖拉机迎亲；之后八九天她照老价接村里活，攒下七块，借陆长庚三块凑十块本钱，决定做成衣赶乡集",
      "reader_knowledge": "同客观事实",
      "reveal_chapter": 7,
      "reveal_status": "已揭示",
      "story_time": "1983年开春，换亲后约第二十天到第二十九天",
      "updated_chapter": 7
    },
    "E011": {
      "characters": [
        "宋青禾",
        "陆长庚",
        "杨淑琴"
      ],
      "first_recorded_chapter": 8,
      "id": "E011",
      "objective_fact": "宋青禾在乡供销社处理布柜花十块买布（含雨淋白的确良整卷三块），两夜做出七件成衣，定价全卖二十四块五",
      "reader_knowledge": "同客观事实",
      "reveal_chapter": 8,
      "reveal_status": "已揭示",
      "story_time": "1983年开春，换亲后约第三十一天到第三十三天",
      "updated_chapter": 8
    },
    "E012": {
      "characters": [
        "宋青禾",
        "陆长庚",
        "杨淑琴"
      ],
      "first_recorded_chapter": 9,
      "id": "E012",
      "objective_fact": "第一个集七件成衣卖空，到手二十四块四；拆穿一个拿假大团结赊账的骗子；当天十九块买第二批处理布，剩五块四",
      "reader_knowledge": "同客观事实",
      "reveal_chapter": 9,
      "reveal_status": "已揭示",
      "story_time": "1983年开春，换亲后约第三十四天（逢五集）",
      "updated_chapter": 9
    },
    "E013": {
      "characters": [
        "宋青禾",
        "陆长庚",
        "郑卫东"
      ],
      "first_recorded_chapter": 10,
      "id": "E013",
      "objective_fact": "第二个集十二件卖空，七人交定钱订货（红裙四、白衬衫二、两用衫一，半个月内交）；当面还清郑卫东三十；夜里手上二十一块三，七块定钱单包",
      "reader_knowledge": "同客观事实",
      "reveal_chapter": 10,
      "reveal_status": "已揭示",
      "story_time": "1983年春，换亲后约第三十九天（逢十集）",
      "updated_chapter": 10
    },
    "E014": {
      "characters": [
        "赵铁柱",
        "赵春花",
        "宋青禾"
      ],
      "first_recorded_chapter": 10,
      "id": "E014",
      "objective_fact": "赵家要把赵春花卖给黑石沟一个死了老婆的光棍，一百八十块，已收五十定钱，次日一早来领人；当夜春花翻梁逃到陆家，被宋青禾收下当女工",
      "reader_knowledge": "同客观事实（春花亲口说出）",
      "reveal_chapter": 11,
      "reveal_status": "已揭示",
      "story_time": "1983年春，换亲后约第三十九天",
      "updated_chapter": 11
    },
    "E015": {
      "characters": [
        "宋青禾",
        "赵春花",
        "赵铁柱",
        "陆长庚",
        "孙守田"
      ],
      "first_recorded_chapter": 12,
      "id": "E015",
      "objective_fact": "赵铁柱带人到陆家要人被挡；春花当众作证小年夜那晚；刘家峪刘老汉退回两百块告到公社；赵铁柱被民兵扭送公社公安特派员",
      "reader_knowledge": "同客观事实；谁把刘秀兰推下井春花没看见，由公社定",
      "reveal_chapter": 12,
      "reveal_status": "已揭示",
      "story_time": "1983年春，换亲后第四十天",
      "updated_chapter": 12
    },
    "E016": {
      "characters": [
        "宋青禾",
        "周文斌",
        "杨淑琴",
        "陆长庚"
      ],
      "first_recorded_chapter": 13,
      "id": "E016",
      "objective_fact": "周文斌交代乡供销社不卖处理布给宋青禾，盘库清出的处理的确良给国营缝纫社；拿处理品限量、先尽国营、不给倒卖行方便的「规定」堵门",
      "reader_knowledge": "同客观事实",
      "reveal_chapter": 13,
      "reveal_status": "已揭示",
      "story_time": "1983年春，换亲后第四十二天（月底盘库后第一天）",
      "updated_chapter": 13
    },
    "E017": {
      "characters": [
        "宋青禾",
        "宋青梅",
        "陆长庚",
        "赵春花"
      ],
      "first_recorded_chapter": 14,
      "id": "E017",
      "objective_fact": "两个订白衬衫的退定钱，定钱剩五块；宋青禾当众押下剩五件半个月内交不上定钱退双份；当夜决定进县城找县布厂",
      "reader_knowledge": "同客观事实",
      "reveal_chapter": 14,
      "reveal_status": "已揭示",
      "story_time": "1983年春，换亲后第四十四天（头一个交货的集）",
      "updated_chapter": 14
    },
    "E018": {
      "characters": [
        "宋青梅",
        "周文斌"
      ],
      "first_recorded_chapter": 13,
      "id": "E018",
      "objective_fact": "宋青梅过门，嫁进乡里周家",
      "reader_knowledge": "第13章周文斌说「你姐都过门了」才带出",
      "reveal_chapter": 13,
      "reveal_status": "已揭示",
      "story_time": "1983年春，换亲后约第三十六天",
      "updated_chapter": 13
    },
    "E019": {
      "characters": [
        "宋青禾",
        "陆长庚",
        "冯玉兰",
        "郑卫东"
      ],
      "first_recorded_chapter": 15,
      "id": "E019",
      "objective_fact": "陆长庚夜里走到乡里借公社电话找卫东；第四十五天坐卫东回空车进县城；第四十六天在县布厂四毛一尺买色差的确良四十五尺共十八块，开盖章发票，经手冯玉兰；傍晚回乡",
      "reader_knowledge": "同客观事实",
      "reveal_chapter": 15,
      "reveal_status": "已揭示",
      "story_time": "1983年春，换亲后第四十四天夜到第四十六天傍晚",
      "updated_chapter": 15
